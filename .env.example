# WyBuild server environment
APP_URL=https://wybuild-black.vercel.app
SESSION_SECRET=replace-with-a-long-random-secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Flutterwave v4 OAuth + encryption
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
FLW_ENCRYPTION_KEY=
# Production: https://f4bexperience.flutterwave.com
# Sandbox: https://developersandbox-api.flutterwave.com
FLW_V4_BASE_URL=https://f4bexperience.flutterwave.com
FLW_SECRET_HASH=

# Vercel Cron authentication
CRON_SECRET=
# Storage: Firestore only. Project ID is read from project_id inside this service-account JSON.
# Paste raw JSON or base64-encoded JSON. Server-side only; never commit or expose it to the browser.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional: only for a one-time migration of existing data from Supabase; not used by the deployed app.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Gemini build diagnosis and safe code repair (server-side only). GEMINI_MODEL selects the active model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Configure these to the actual model price for your Google AI billing tier (USD per 1M tokens).
GEMINI_INPUT_USD_PER_MILLION=0.30
GEMINI_OUTPUT_USD_PER_MILLION=2.50

# Default release keystore: copied into the selected repo's GitHub Actions secrets before every build.
# Configuring this key intentionally replaces WB_KEYSTORE_* secrets in target repos so all builds
# share the same signing identity. Base64 encode your .jks/.p12 (GitHub secret limit: 48 KB).
WB_KEYSTORE_BASE64=
WB_KEYSTORE_PASSWORD=
WB_KEY_ALIAS=
WB_KEY_PASSWORD=

# Optional: publish WyBuild's own Digital Asset Links when WyBuild is built as a TWA.
# Never use a fake fingerprint. Use the SHA-256 of the exact release signing certificate.
WYBUILD_ANDROID_PACKAGE_ID=
WYBUILD_ANDROID_SHA256=
# Optional Google Play app-signing SHA-256 (comma/space separated with the above if needed).
WYBUILD_PLAY_SIGNING_SHA256=

# Kivora ad-campaign payment confirmation (server-to-server from WyBuild webhook)
KIVORA_PAYMENT_CONFIRM_URL=https://YOUR-KIVORA-DOMAIN/api/wybuild-payment-confirmation
KIVORA_WEBHOOK_SHARED_SECRET=replace-with-a-long-random-shared-secret

# WyCut recap purchases: WyBuild verifies Flutterwave v4 charges, then forwards authoritative details to WyCut.
WYCUT_PAYMENT_CONFIRM_URL=https://YOUR-WYCUT-DOMAIN/api/wybuild-payment-confirmation
WYCUT_WEBHOOK_SHARED_SECRET=replace-with-the-same-long-random-secret-configured-in-WyCut

# GitHub webhook HMAC secret for workflow_run build-completion notifications (24+ chars)
WYBUILD_PUSH_WEBHOOK_SECRET=
