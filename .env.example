# WyBuild server environment
APP_URL=https://wybuild-black.vercel.app
SESSION_SECRET=replace-with-a-long-random-secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Flutterwave v4 OAuth + encryption
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
FLW_ENCRYPTION_KEY=
# Production: https://f4bexperience.flutterwave.com
# Sandbox: https://developersandbox-api.flutterwave.com
FLW_V4_BASE_URL=https://f4bexperience.flutterwave.com
FLW_SECRET_HASH=

# Vercel Cron authentication
CRON_SECRET=
# Supabase (storage). Run supabase/schema.sql in the SQL Editor first.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Default release keystore (optional but recommended): same names as the GitHub secrets.
# WyBuild copies these into any repo's Actions secrets before every build and on workflow install,
# so no repo ever has to ask for a keystore. base64 -w0 your.jks (max 48 KB). Redeploy after changing.
# A repo that already has its own WB_KEYSTORE_* secrets keeps using them.
WB_KEYSTORE_BASE64=
WB_KEYSTORE_PASSWORD=
WB_KEY_ALIAS=
WB_KEY_PASSWORD=

# Optional: publish WyBuild's own Digital Asset Links when WyBuild is built as a TWA.
# Never use a fake fingerprint. Use the SHA-256 of the exact release signing certificate.
WYBUILD_ANDROID_PACKAGE_ID=
WYBUILD_ANDROID_SHA256=
# Optional Google Play app-signing SHA-256 (comma/space separated with the above if needed).
WYBUILD_PLAY_SIGNING_SHA256=
